APP_NAME="AHNet ISP Dashboard"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8879

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Application database (Laravel app: users, roles, devices, snmp_logs, etc.)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ahnet_dashboard
DB_USERNAME=ahnet
DB_PASSWORD=change_me

# ---------------------------------------------------------------------------
# FreeRADIUS database (existing tables: radcheck, radreply, radusergroup,
# radgroupreply, radacct). We connect read/write through a separate Laravel
# connection named "radius" (see config/database.php).
# ---------------------------------------------------------------------------
RADIUS_DB_CONNECTION=mysql
RADIUS_DB_HOST=127.0.0.1
RADIUS_DB_PORT=3306
RADIUS_DB_DATABASE=radius
RADIUS_DB_USERNAME=radius
RADIUS_DB_PASSWORD=change_me

# Default RADIUS group for new PPPoE users
RADIUS_DEFAULT_PPPOE_GROUP=pppoe-default
# Default RADIUS group for hotspot vouchers
RADIUS_DEFAULT_HOTSPOT_GROUP=hotspot-default
# Username prefix for generated PPPoE accounts (e.g. ahnet_budi#82)
PPPOE_USERNAME_PREFIX=ahnet_

# ---------------------------------------------------------------------------
# Mikrotik default device (used by MikrotikService when no device_id is given)
# ---------------------------------------------------------------------------
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=
MIKROTIK_PORT=8728
MIKROTIK_USE_SSL=false

# ---------------------------------------------------------------------------
# SNMP defaults (v2c)
# ---------------------------------------------------------------------------
SNMP_COMMUNITY=public
SNMP_VERSION=2c
SNMP_TIMEOUT=1000000
SNMP_RETRIES=2

# ---------------------------------------------------------------------------
# GenieACS NBI (Northbound Interface)
# Usually exposed on http://genieacs:7557 (NBI). UI on :3000.
# ---------------------------------------------------------------------------
GENIEACS_NBI_URL=http://127.0.0.1:7557
GENIEACS_USERNAME=
GENIEACS_PASSWORD=
GENIEACS_TIMEOUT=10

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@ahnet.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
